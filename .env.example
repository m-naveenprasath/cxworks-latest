# Public site URL used for canonical links, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://cxworks.com
# Formspree (or compatible) endpoint the lead forms POST to.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mvkkoyve
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console verification token.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Products section (/products/) ---
# Where "Start free trial" sends people after sign-up.
NEXT_PUBLIC_QUERYPRISM_TRIAL_URL=https://app.queryprism.ai
# "Explore NUARK" link.
NEXT_PUBLIC_NUARK_URL=https://nuark.ai/
# Formspree endpoints for the product sign-up forms.
NEXT_PUBLIC_QUERYPRISM_SIGNUP_ENDPOINT=https://formspree.io/f/moeeqbyr
NEXT_PUBLIC_NUARK_WAITLIST_ENDPOINT=https://formspree.io/f/moeeqbyr
